  <subsection xml:id="subsec-Evaluating-Functions-Exercises">
      <title>Graded Exercises</title>
      
  <exercise label="Evaluating-Function-exercise1">
        <statement>
            <p>
                In function notation, <m>f(5)=-2</m> match each of the following.
            </p>
        </statement>
        <cardsort>

      <match>
      <premise order="1"><m>-2</m></premise>
      <response>Output</response>
      </match>

      <match>
      <premise order="2"><m>5</m></premise>
      <response>Input</response>
      </match>

      <match>
      <premise order="3"><m>f</m></premise>
      <response>Name of Function</response>
      </match>
      </cardsort>
      </exercise>

  <exercise label="Evaluating-Function-exercise2">
    <statement>
      <p>
          Use the table to identify the values.
      </p>
      <table>
        <title>Input-Output Table for <m>f(x)</m></title>
        <tabular>
            <col right="minor"/>
            <col right="minor"/>
            <col right="minor"/>
            <col right="minor"/>
            <col right="minor"/>
            <col/>
            <row bottom="minor">
                <cell><m>x</m></cell>
                <cell><m>0</m></cell>
                <cell><m>2</m></cell>
                <cell><m>4</m></cell>
                <cell><m>6</m></cell>
                <cell><m>8</m></cell>
            </row>

            <row>
                <cell><m>f(x)</m></cell>
                <cell><m>5</m></cell>
                <cell><m>6</m></cell>
                <cell><m>3</m></cell>
                <cell><m>0</m></cell>
                <cell><m>2</m></cell>
            </row>
        </tabular>
      </table>   
      <p>
      <m>f(0)=</m><fillin mode="math" width="8" answer="5" name="firstD"/>
      </p>
      <p>
        When <m>x=</m><fillin mode="math" width="8" answer="8" name="secondD"/>, then <m>f(x)=2</m>.
      </p>
      </statement>
      
      <evaluation> 
      <evaluate submit="firstD"> <test correct="yes"> <numcmp use-answer="yes"/> </test> </evaluate> 
      
      <evaluate submit="secondD"> <test correct="yes"> <numcmp use-answer="yes"/> </test> </evaluate>
      </evaluation>  
    </exercise>

  <exercise label="Evaluating-Function-exercise3">
    <statement>
      <p>
          Use the graph of <m>g(x)</m> to fill in the blanks.
      </p>
 
      <figure xml:id="Evaluating-Function-exercise3-figure1">
     <image width="60%">
        <prefigure xmlns="https://prefigure.org" label="Evaluating-Function-exercise3-prefigure1">
            <title>Graph of <m>g(x)</m></title>
            <description>Graph of Quadratic Function</description>
        <diagram dimensions="(300,300)" margins="5">
        <coordinates bbox="(-4,-2,4,5)">
          <grid-axes xlabel="x" ylabel="y"/>
          <point p="(-3,0)" fill="blue"/>
          <point p="(0,4)" fill="blue"/>
          <point p="(1,3)" fill="blue"/>
          <point p="(3,3)" fill="blue"/>
          <line endpoints="((-3,0), (0,4))" stroke="blue" infinite="no"/>
          <line endpoints="((0,4), (1,3))" stroke="blue" infinite="no"/>
          <line endpoints="((1,3), (3,3))" stroke="blue" infinite="no"/>
        </coordinates>
      </diagram>
    </prefigure> 
    </image>
    </figure>

      <p>
      <m>g(1)=</m><fillin mode="math" width="8" answer="3" name="firstD"/>
      </p>
      <p>
        When <m>x=</m><fillin mode="math" width="8" answer="-3" name="secondD"/>, then <m>g(x)=0</m>.
      </p>
      </statement>
      
      <evaluation> 
      <evaluate submit="firstD"> <test correct="yes"> <numcmp use-answer="yes"/> </test> </evaluate> 
      
      <evaluate submit="secondD"> <test correct="yes"> <numcmp use-answer="yes"/> </test> </evaluate>
      </evaluation>  
    </exercise>

  <exercise label="Evaluating-Function-exercise4">
        <statement>
            <p>
                The temperature on campus can be modeled by the function <m>T=p(h)</m> where <m>T</m> is the temperature in degrees Fahrenheit and <m>h</m> is the number of hours after sunrise. 
            </p>
            <p>
              Choose the correct interpretation for the function notation <m>p(3)=74</m>.
            </p>
        </statement>

        <choices>
          <choice correct="no">
        <statement>
          <p>
            An input of <m>3</m> is paired with an output of <m>74</m>.
          </p>
        </statement>
      </choice>
      <choice correct="no">
        <statement>
          <p>
            An input of <m>74</m> is paired with an output of <m>3</m>. 
          </p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>
            Three hours after sunrise it is <m>74</m> degrees Fahrenheit on campus. 
          </p>
        </statement>
      </choice>
      <choice correct="no">
        <statement>
          <p>
            Seventy four hours after sunrise it is <m>3</m> degrees Fahrenheit on campus.
          </p>
        </statement>
      </choice>
    </choices>
    </exercise>

  </subsection> 


  
</section>
