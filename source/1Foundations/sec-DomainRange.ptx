  <subsection xml:id="subsec-Domain-Range-Exercises">
      <title>Graded Exercises</title>

      <exercise label="Domain-Range-exercise1">
      <statement>
        <p>
          The domain is the set of all
        </p>
      </statement>

  <choices>
    <choice correct="yes">
      <statement><p>inputs to a function.</p></statement>
    </choice>
    <choice>
      <statement><p>outputs of a function.</p></statement>
    </choice>
    <choice>
      <statement><p>ordered pairs of a function.</p></statement>
    </choice>
    <choice>
      <statement><p>maximum values of a function.</p></statement>
    </choice>
  </choices>
</exercise>

  <exercise label="Domain-Range-exercise2">
  <statement>
    <p>
      The range is the set of all
    </p>
  </statement>

  <choices>
    <choice>
      <statement><p>inputs to a function.</p></statement>
    </choice>
    <choice correct="yes">
      <statement><p>outputs of a function.</p></statement>
    </choice>
    <choice>
      <statement><p>ordered pairs of a function.</p></statement>
    </choice>
    <choice>
      <statement><p>independent values of a function.</p></statement>
    </choice>
  </choices>
</exercise>

<exercise label="Domain-Range-exercise3">
  <statement>
    <p>
      The inequality <m>-4 \le x \lt 8</m> is represented by the interval
    </p>
  </statement>

  <choices>
    <choice>
      <statement><p><m>[-4,8]</m></p></statement>
    </choice>
    <choice>
      <statement><p><m>(-4,8]</m></p></statement>
    </choice>
    <choice correct="yes">
      <statement><p><m>[-4,8)</m></p></statement>
    </choice>
    <choice>
      <statement><p><m>(-4,8)</m></p></statement>
    </choice>
  </choices>
</exercise>

<exercise label="Domain-Range-exercise4">

  <statement>
    <p>
      Use the graph of the function to answer the questions.
      If no endpoint is shown, assume that the graph continues on forever.
      Enter <q>infty</q> for <m>\infty</m> when using interval notation.
    </p>

    <figure xml:id="Domain-Range-exercise4-figure">
      <image width="60%">
        <prefigure xmlns="https://prefigure.org"
                   label="domain-range-exercise4-prefigure">

          <title>Bounded Domain and Range</title>

          <diagram dimensions="(300,300)" margins="5">
            <definition>f(x)=.25*x^3+1</definition>

            <coordinates bbox="(-4,-4,4,4)">
              <grid-axes xlabel="x" ylabel="y"/>

              <graph at="graph" function="f" domain="(-2,2)"/>

              <point p="(-2,-1)" fill="blue"/>
              <point p="(2,3)" fill="white" stroke="black"/>
            </coordinates>
          </diagram>

        </prefigure>
      </image>
    </figure>

    <p>
      The domain of the function is
      <fillin mode="string" answer="[-2,2)" width="10"/>.
    </p>

    <p>
      The range of the function is
      <fillin mode="string" answer="[-1,3)" width="10"/>.
    </p>

  </statement>

  <evaluation>

    <!-- Domain -->
    <evaluate>

      <!-- Accept [-2,2) or [-2, 2) -->
      <test correct="yes">
        <strcmp>\[-2,\s*2\)</strcmp>
        <feedback>
          <p>
            Correct! The graph begins at <m>x=-2</m> with a closed point,
            so <m>-2</m> is included. The graph ends at <m>x=2</m> with
            an open point, so <m>2</m> is not included.
          </p>
        </feedback>
      </test>

      <!-- Any other response -->
      <test>
        <strcmp>.*</strcmp>
        <feedback>
          <p>
            Not quite. Look at the endpoints of the graph. The point at
            <m>x=-2</m> is closed, while the point at <m>x=2</m> is open.
          </p>
        </feedback>
      </test>

    </evaluate>

    <!-- Range -->
    <evaluate>

      <!-- Accept [-1,3) or [-1, 3) -->
      <test correct="yes">
        <strcmp>\[-1,\s*3\)</strcmp>
        <feedback>
          <p>
            Correct! The graph reaches <m>y=-1</m> at a closed point,
            so <m>-1</m> is included. The graph approaches <m>y=3</m>
            at an open point, so <m>3</m> is not included.
          </p>
        </feedback>
      </test>

      <!-- Any other response -->
      <test>
        <strcmp>.*</strcmp>
        <feedback>
          <p>
            Not quite. The lowest output is <m>-1</m> and is included,
            while the graph has an open point at <m>y=3</m>.
          </p>
        </feedback>
      </test>

    </evaluate>

  </evaluation>

</exercise>

<exercise label="Domain-Range-exercise5">

  <statement>
    <p>
      Use the graph of the function to answer the questions.
      If no endpoint is shown, assume that the graph continues on forever.
      Enter <q>infty</q> for <m>\infty</m> when using interval notation.
    </p>

    <figure xml:id="Domain-Range-exercise5-figure">
      <image width="60%">
        <prefigure xmlns="https://prefigure.org"
                   label="domain-range-exercise5-prefigure">
          <title>Bounded Domain and Range</title>

          <diagram dimensions="(300,300)" margins="5">
            <definition>f(x)=-.25*x^3+1</definition>
            <coordinates bbox="(-4,-4,4,4)">
              <grid-axes xlabel="x" ylabel="y"/>
              <graph at="graph" function="f" domain="(-2,2.6)" arrows="1"/>
              <point p="(-2,3)" fill="white" stroke="black"/>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
    </figure>

    <p>
      The domain of the function is
      <fillin mode="string" answer="(-2,infty)" width="10"/>.
    </p>

    <p>
      The range of the function is
      <fillin mode="string" answer="(-infty,3]" width="10"/>.
    </p>

  </statement>

  <evaluation>

    <!-- Domain -->
    <evaluate>

      <!-- Accept (-2, infty) (-2, infinity) or (-2, ∞) -->
      <test correct="yes">
        <strcmp>\(-2,\s*(?:infty|infinity|∞)\)</strcmp>
        <feedback>
          <p>
            Correct! The graph begins at <m>x=-2</m> with an open point,
            so <m>-2</m> is not included. The graph continues to the right without bound, so <m>\infty</m> is not included.
          </p>
        </feedback>
      </test>

      <!-- Any other response -->
      <test>
        <strcmp>.*</strcmp>
        <feedback>
          <p>
            Not quite. Look at the endpoints of the graph. The point at
            <m>x=-2</m> is open, while there is no endpoint on the right.
          </p>
        </feedback>
      </test>

    </evaluate>

    <!-- Range -->
    <evaluate>

      <!-- Accept (-infty,3) (-infinity,3) or (-∞,3) -->
      <test correct="yes">
        <strcmp>\(-(?:infty|infinity|∞),\s*3\)</strcmp>
        <feedback>
          <p>
            Correct! The graph reaches <m>y=3</m> at an open point,
            so <m>3</m> is not included. The graph continues downward without bound, so <m>-infty</m> is not included.
          </p>
        </feedback>
      </test>

      <!-- Any other response -->
      <test>
        <strcmp>.*</strcmp>
        <feedback>
          <p>
            Not quite. The lowest output is <m>-infty</m> and is not included,
            while the graph has an open point at <m>y=3</m>.
          </p>
        </feedback>
      </test>

    </evaluate>

  </evaluation>

</exercise>
   
   
   

      </subsection>

</section>

